# ─────────────────────────────────────────────────────
# Tarkis Site — variáveis de ambiente
# Copie para .env e preencha
# ─────────────────────────────────────────────────────

# URL de produção
PUBLIC_SITE_URL=https://tarkis.com.br

# Google Analytics (opcional)
# PUBLIC_GA_ID=G-XXXXXXXXXX

# SMTP — envio do formulário "Solicitar Demonstração" (obrigatório)
SMTP_HOST=smtp.exemplo.com.br
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=usuario@exemplo.com.br
SMTP_PASS=
CONTACT_TO_EMAIL=contato@tarkis.com.br

# reCAPTCHA v3 (opcional)
# PUBLIC_RECAPTCHA_KEY=6Lxxx...
